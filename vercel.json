{
  "rewrites": [
    { "source": "/admin", "destination": "/admin-app.html" },
    { "source": "/genka", "destination": "/genka-app.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), payment=(), usb=(), serial=(), bluetooth=()" }
      ]
    }
  ]
}
